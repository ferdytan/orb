# ==============================================================================
# ORB FRONTEND - Apache .htaccess configuration for orb.krftworks.my.id
# Document Root: /home/CPANEL_USER/krftworks/orb/frontend (or public_html/orb/frontend)
# ==============================================================================
# Pada subdomain ini, document root menunjuk langsung ke direktori `frontend/`.
# Semua asset (css/, js/, assets/) berada di root URL (`/css/...`, `/js/...`).
#
# PENTING:
# 1. Jangan gunakan RewriteBase /orb/ di sini.
# 2. Matikan rewrite engine agar rule dari direktori induk tidak membajak request
#    aset statis menjadi HTML atau path yang salah.
# 3. Nonaktifkan Phusion Passenger pada folder frontend ini agar file statis
#    dilayani langsung oleh Apache tanpa diteruskan ke Python WSGI.
# 4. Jangan membuat fallback 404 yang mengembalikan index.html untuk aset yang
#    tidak ada karena browser akan menolak CSS/JS akibat MIME type text/html.
# ==============================================================================

# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/satulogi/krftworks/orb"
PassengerBaseURI "/"
PassengerPython "/home/satulogi/virtualenv/krftworks/orb/3.11/bin/python"
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

DirectoryIndex index.html

# Serve existing static files directly via LiteSpeed / Apache
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Root request serves index.html directly as static file
    RewriteRule ^$ index.html [L]

    # Existing static files and directories are served directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>

<IfModule mod_passenger.c>
    PassengerEnabled on
</IfModule>
